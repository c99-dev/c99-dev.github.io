{
  "name": "aram-ramdon-pick",
  "homepage": "https://c99-dev.github.io/",
  "version": "1.0.0",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm audit && npm test && npm run test:data && npm run validate-data && npm run build",
    "fetch-data": "python scripts/update_data.py",
    "validate-data": "python scripts/validate_data.py",
    "test:data": "python -m unittest discover -s scripts -p test_*.py",
    "predeploy": "npm run validate-data && npm run build",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-modal": "^3.16.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.1.1",
    "jsdom": "^29.1.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
